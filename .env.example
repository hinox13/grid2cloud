# Copy to .env (gitignored) or export in your shell. Never commit real values.

# UKPN Open Data Portal API key — required for UKPN records/exports.
# Create at https://ukpowernetworks.opendatasoft.com → profile → API keys.
UKPN_API_KEY=

# Optional: Hugging Face token. Not required for the public gridfm/* checkpoints and datasets
# used in E0; only set it if you hit anonymous rate limits.
HF_TOKEN=

# Required by gridfm-graphkit's MLflow file store (set automatically by run_genco_baseline.py).
MLFLOW_ALLOW_FILE_STORE=true

# Julia executable used by gridfm-datakit's PowerModels backend (juliacall/juliapkg).
# Point at the REAL binary, not a symlink: juliacall resolves sys.so relative to this path.
# Example on this machine: /opt/julia-1.10.4/bin/julia
PYTHON_JULIAPKG_EXE=

# Satellite stage (E3) — free registrations; names only, never commit values.
# LSA SAF data service (https://mokey.lsasvcs.ipma.pt/auth/signup)
LSASAF_USERNAME=
LSASAF_PASSWORD=
# EUMETSAT Data Store API credentials (EUMETSAT EO Portal account → API key).
# NOT needed for the E-View / Natural Colour RGB layer (distributed only via anonymous
# EUMETView WMS); kept for possible future Data Store products.
EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=
